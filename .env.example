# settings-api -- example environment
#
# Every variable is prefixed SETTINGS_API_. A SETTINGS_API_-prefixed variable matching no
# setting is a STARTUP ERROR, not a warning: pydantic-settings would otherwise ignore it,
# and SETTINGS_API_ALOWED_NAMESPACES would leave the namespace list on its default with
# nothing in the logs to say so.
#
# Copy to .env and edit. Nothing here is required to start a local instance.

# -- Identity ---------------------------------------------------------------------------
SETTINGS_API_APP_NAME=settings
SETTINGS_API_ENVIRONMENT=local

# -- Observability ----------------------------------------------------------------------
SETTINGS_API_LOG_LEVEL=INFO
# json in deployment so records are queryable; console locally.
SETTINGS_API_LOG_FORMAT=json

# -- Serving ----------------------------------------------------------------------------
# Loopback by default. This service belongs behind a TLS-terminating proxy.
SETTINGS_API_HOST=127.0.0.1
SETTINGS_API_PORT=8003

# -- Storage ----------------------------------------------------------------------------
# The one file everything lives in. NOT ENCRYPTED: the file mode (0600) is the only thing
# between a person's decisions and every other process on the box. Never put it on a
# shared volume, and never commit it.
SETTINGS_API_DATABASE_PATH=var/settings.db

# -- Who we believe, and why ------------------------------------------------------------
# Where keyring publishes the public half of its signing key. Fetched lazily and cached;
# nothing is fetched at startup, so a keyring that is down does not stop this service
# starting. Requires no change in keyring: user tokens presented by a service are verified
# against this same public document.
SETTINGS_API_KEYRING_JWKS_URL=http://127.0.0.1:8001/.well-known/jwks.json

# Pinned against every token's `iss`. A token from anywhere else is not a token. Must match
# keyring's own KEYRING_ISSUER exactly.
SETTINGS_API_KEYRING_ISSUER=http://127.0.0.1:8001

# The audience family the PERSON-facing surface answers to. `settings` grants every
# namespace; `settings.search` grants exactly the search namespace plus common.
SETTINGS_API_AUDIENCE_PREFIX=settings

# Every namespace an audience may name. Narrowing this is how a deployment turns a
# namespace off; a service granted a namespace this list excludes is a startup error.
# Defaults to every namespace in the build's catalogue.
# SETTINGS_API_ALLOWED_NAMESPACES=["common","keyring","user","persona","media","spotify","search"]

SETTINGS_API_JWKS_CACHE_SECONDS=3600
# The floor between two fetches provoked by an unknown `kid`. Load-bearing rather than a
# tuning knob: without it, a stream of tokens with random kid headers is one outbound fetch
# per inbound request -- a DoS amplifier pointed at keyring, aimed by anyone who can reach
# this service holding no token at all.
SETTINGS_API_JWKS_MIN_REFETCH_SECONDS=60
SETTINGS_API_KEYRING_HTTP_TIMEOUT_SECONDS=5

# -- Consuming services -----------------------------------------------------------------
# One JSON document rather than a nested tree, because a nested spelling cannot be
# enumerated -- and a configuration this service cannot enumerate is one the typo check
# above cannot check.
#
# Per service:
#   token            this service's own bearer token. At least 32 characters, and NEVER
#                    shared with another service -- both are startup errors. Two services
#                    sharing one would make the audience check below meaningless.
#   audience_prefix  the audience family keyring mints THAT SERVICE's user tokens under.
#                    Deliberately independent of the service's name. This is the
#                    confused-deputy defence: media-tool may present only tokens minted
#                    for media-tool.
#   namespaces       what it may read and write. `common` is added automatically -- do not
#                    list it. Give the narrowest list that works: the blast radius of one
#                    compromised service token is exactly this list.
#
# Empty by default, which gives a working person-facing surface and a /v1/internal that
# refuses everything. That is the right state for a service nobody has been told to trust.
#
# SETTINGS_API_SERVICES={"user-api":{"token":"CHANGE-ME-32-CHARACTERS-MINIMUM-01","audience_prefix":"user","namespaces":["user"]},"persona-api":{"token":"CHANGE-ME-32-CHARACTERS-MINIMUM-02","audience_prefix":"persona","namespaces":["persona"]},"media-tool":{"token":"CHANGE-ME-32-CHARACTERS-MINIMUM-03","audience_prefix":"media-tool","namespaces":["media"]},"spotify-api":{"token":"CHANGE-ME-32-CHARACTERS-MINIMUM-04","audience_prefix":"spotify","namespaces":["spotify"]},"web-search-api":{"token":"CHANGE-ME-32-CHARACTERS-MINIMUM-05","audience_prefix":"web-search-api","namespaces":["search"]},"keyring-api":{"token":"CHANGE-ME-32-CHARACTERS-MINIMUM-06","audience_prefix":"keyring","namespaces":["keyring"]}}

# -- Operator policy --------------------------------------------------------------------
# A JSON file narrowing or pinning catalogue entries for this deployment. Absent by
# default, which means the catalogue stands as written. A policy may make a bound TIGHTER,
# change the default within the bounds that result, and PIN a value. It may never loosen a
# bound, add an enum choice or raise a cap -- and a policy that tries is a startup error.
#
# A configured path that does not exist is also a startup error, deliberately: a deployment
# that meant to narrow something and mistyped the path would otherwise run wide open and
# look correct.
#
# Example var/policy.json:
#   {
#     "media": {"artifact_retention_hours": {"maximum": 24}},
#     "search": {"max_content_chars": {"default": 20000}},
#     "user":   {"log_values": {"pin": false}}
#   }
# SETTINGS_API_POLICY_PATH=var/policy.json

# -- Limits -----------------------------------------------------------------------------
# Per account. The change log is trimmed to this in the same transaction that appends.
SETTINGS_API_MAX_EVENTS=2000

# The serialized size of one setting value, whatever the catalogue's own bounds say. A
# backstop rather than a per-setting rule.
SETTINGS_API_MAX_VALUE_BYTES=4096

# What a consuming service is told to cache a resolved namespace for. Revalidation is an
# ETag and a 304, so this trades a minute of staleness for most of the request volume.
SETTINGS_API_CACHE_TTL_SECONDS=60

# -- Retention --------------------------------------------------------------------------
# How long a retired key's rows survive before the sweeper destroys them. NOT zero, and
# that is the point: reads ignore a retired key immediately, so reverting the catalogue
# inside this window restores every affected person's choice intact. Deleting on sight
# would destroy them all the moment somebody merged a typo.
SETTINGS_API_RETIRED_RETENTION_DAYS=90
SETTINGS_API_SWEEP_INTERVAL_SECONDS=3600
